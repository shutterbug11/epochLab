{
  "compilerOptions": {
    "module": "commonjs",
    "removeComments": true,
    "preserveConstEnums": true,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "types": [
      "d3"
    ],
    "skipLibCheck": true,
    "lib": ["dom", "es5", "es2015.promise", "es2015.iterable"]
  },
  "exclude": [
    "node_modules" 
  ]
}
